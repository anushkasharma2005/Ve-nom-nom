# =============================================================================
# .gitignore
# =============================================================================

# ── Model weights (large binary — don't commit to git) ─────────────────────
backend/models/*.pt
backend/models/*.pth

# ── Gemini cache (regenerated at runtime) ──────────────────────────────────
backend/cache/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
.uv/
*.egg-info/
dist/
build/

# ── Node / frontend ─────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Built static output (generated by npm run build) ───────────────────────
backend/static/

# ── Environment / secrets ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Editor ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
